# =============================================================================
# PEDRO_ARTE_DNA_MY_CREATIVE_BRAIN - environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
CREATIVE_BRAIN_ENV=local
CREATIVE_BRAIN_LOG_LEVEL=INFO
# json | text
CREATIVE_BRAIN_LOG_FORMAT=json

# --- LLM provider selection -------------------------------------------------
# mock | anthropic | openai
CREATIVE_BRAIN_LLM_PROVIDER=mock

# Deterministic seed for the mock provider and controlled randomness.
CREATIVE_BRAIN_RANDOM_SEED=20260807

# --- Anthropic (only required when provider=anthropic) ----------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- OpenAI (only required when provider=openai) ----------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Research providers (optional; disabled by default) ---------------------
CREATIVE_BRAIN_RESEARCH_PROVIDER=offline
RESEARCH_API_KEY=

# --- Budgets ----------------------------------------------------------------
CREATIVE_BRAIN_MAX_LLM_CALLS_PER_CYCLE=400
CREATIVE_BRAIN_MAX_USD_PER_CYCLE=5.0
